@model Device
<h5>The name of device :  @Model.Name</h5>
<p>The ID of the device is :@Model.Id</p>
<p>The asset tag is :@Model.AssetTag</p>
<p>The category of the device is :@Model.Category</p>...
<p>The Purchase Year of the device is :@Model.PurchaseYear</p>
<p>If device is on loan: @Model.IsOnLoan</p>
<a href="/devices/@Model.Id"> Individual Details</a>
<a href="/devices/edit/@Model.Id">Edit A Device</a>
<a href="/devices/delete/@Model.Id">Delete</a>